---
import { z } from "astro/zod";

import { getOfficialAssetsForSign } from "../lib/content/essential-signs";
import { getLessonVisualSet } from "../lib/content/lesson-visuals";
import { withBase } from "../lib/paths";

const locale = z.enum(["zh-TW", "en"]).parse(Astro.props.locale);
const lessonId = z.string().regex(/^M\d{2}-[a-z0-9-]+$/).parse(Astro.props.lessonId);
const excludeDiagramIds = z.array(z.string().regex(/^D\d{3}$/)).parse(
  Astro.props.excludeDiagramIds ?? [],
);
const visualSet = getLessonVisualSet(lessonId);
const diagramPairs = visualSet.diagramPairs.filter(
  ({ diagram }) => !excludeDiagramIds.includes(diagram.id),
);
const isEnglish = locale === "en";
const copy = isEnglish
  ? {
      eyebrow: "See it before you meet it",
      title: "What should you notice in this situation?",
      intro: "Start with the road scene, identify the trap, then remember one action you can use behind the wheel.",
      situation: "Situation",
      watch: "Watch for",
      actionLabel: "Do this",
      decision: "How to read it",
      signTitle: "Signs to recognize in this lesson",
      meaning: "Meaning",
      action: "What to do",
      officialSource: "See the Japanese reference",
      linkOnly: "Open the Japanese ETC lane guide to see the current sign",
    }
  : {
      eyebrow: "先在這裡看過一次",
      title: "遇到這個情況，你要先注意什麼？",
      intro: "先看道路情境，抓出最容易犯的錯，再記住一個上路就能用的動作。",
      situation: "情境",
      watch: "先注意",
      actionLabel: "建議做法",
      decision: "看圖判斷",
      signTitle: "這一課要認得的標誌",
      meaning: "代表什麼",
      action: "看到怎麼做",
      officialSource: "查看日本圖例",
      linkOnly: "開啟日本 ETC 車道圖例，先認清現場樣式",
    };
const headingId = `${lessonId}-visuals-title`;
---

<section class="lesson-visuals" aria-labelledby={headingId} data-lesson-visuals data-visuals-for={lessonId}>
  <header class="section-heading lesson-visuals__heading">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h2 id={headingId}>{copy.title}</h2>
    <p>{copy.intro}</p>
  </header>

  {(diagramPairs.length > 0 || visualSet.illustrations.length > 0) && (
    <div class="lesson-visual-flow" data-count={diagramPairs.length + visualSet.illustrations.length}>
      {visualSet.illustrations.map((illustration) => (
        <figure
          class="lesson-visual-card lesson-visual-card--illustration"
          data-lesson-visual
          data-visual-kind="generated-context-illustration"
          data-illustration-id={illustration.id}
        >
          <img
            src={withBase(illustration.assetPath)}
            width={illustration.width}
            height={illustration.height}
            loading="lazy"
            decoding="async"
            alt={illustration.alt[locale]}
          />
          <figcaption class="visual-teaching-caption">
            <p class="visual-teaching-caption__lead"><span class="visual-badge">{copy.situation}</span>{illustration.guidance.situation[locale]}</p>
            <dl class="visual-teaching-points">
              <div><dt>{copy.watch}</dt><dd>{illustration.guidance.watch[locale]}</dd></div>
              <div><dt>{copy.actionLabel}</dt><dd>{illustration.guidance.action[locale]}</dd></div>
            </dl>
          </figcaption>
        </figure>
      ))}

      {diagramPairs.map(({ diagram, simulation, guidance }) => (
        <article class="lesson-scenario-pair" data-scenario-pair data-paired-diagram-id={diagram.id}>
          <figure
            class="lesson-visual-card lesson-visual-card--simulation"
            data-lesson-visual
            data-visual-kind={simulation.kind === "user_supplied_context_photo" ? "user-supplied-context-photo" : "generated-driver-simulation"}
            data-simulation-id={simulation.id}
          >
            <img
              src={withBase(simulation.assetPath)}
              width={simulation.width}
              height={simulation.height}
              loading="lazy"
              decoding="async"
              alt={simulation.alt[locale]}
            />
            <figcaption class="visual-teaching-caption">
              <p class="visual-teaching-caption__lead"><span class="visual-badge">{copy.situation}</span>{guidance.situation[locale]}</p>
              <dl class="visual-teaching-points">
                <div><dt>{copy.watch}</dt><dd>{guidance.watch[locale]}</dd></div>
              </dl>
            </figcaption>
          </figure>

          <figure
            class="lesson-visual-card lesson-visual-card--diagram"
            data-lesson-visual
            data-visual-kind="deterministic-diagram"
            data-diagram-id={diagram.id}
          >
            <img
              src={withBase(diagram.assetPath)}
              width="1200"
              height="800"
              loading="lazy"
              decoding="async"
              alt={diagram.alt[locale]}
            />
            <figcaption class="visual-teaching-caption">
              <p class="visual-teaching-caption__lead"><span class="visual-badge visual-badge--action">{copy.actionLabel}</span>{guidance.action[locale]}</p>
              <dl class="visual-teaching-points">
                <div><dt>{copy.decision}</dt><dd>{diagram.alt[locale]}</dd></div>
              </dl>
            </figcaption>
          </figure>
        </article>
      ))}
    </div>
  )}

  {visualSet.officialSigns.length > 0 && (
    <section class="lesson-sign-reference" aria-labelledby={`${lessonId}-official-signs-title`}>
      <h3 id={`${lessonId}-official-signs-title`}>{copy.signTitle}</h3>
      <div class="lesson-sign-reference__grid" data-count={visualSet.officialSigns.length}>
        {visualSet.officialSigns.map((sign) => {
          const assets = getOfficialAssetsForSign(sign);
          return (
            <article class="lesson-sign-card" data-sign-id={sign.id} data-rule-id={sign.ruleId}>
              <div class="lesson-sign-card__visual" data-count={assets.length || "link-only"}>
                {assets.map((asset, index) => (
                  <figure class="lesson-sign-card__asset">
                    <img
                      src={withBase(asset.assetPath)}
                      width={asset.width}
                      height={asset.height}
                      loading="lazy"
                      decoding="async"
                      alt={sign.assetLabels?.[index]?.[locale] ?? `${sign.title[locale]}${assets.length > 1 ? ` ${index + 1}` : ""}`}
                      data-asset-id={asset.id}
                    />
                    {sign.assetLabels?.[index] && <figcaption>{sign.assetLabels[index][locale]}</figcaption>}
                  </figure>
                ))}
                {assets.length === 0 && (
                  <div class="lesson-sign-card__link-only">
                    <strong>{copy.linkOnly}</strong>
                  </div>
                )}
              </div>
              <div class="lesson-sign-card__body">
                <p class="visual-badge visual-badge--official">{sign.class[locale]}</p>
                <h4>{sign.title[locale]}</h4>
                <dl>
                  <div><dt>{copy.meaning}</dt><dd>{sign.meaning[locale]}</dd></div>
                  <div><dt>{copy.action}</dt><dd>{sign.action[locale]}</dd></div>
                </dl>
                <a href={sign.officialLink}>{copy.officialSource} ↗</a>
              </div>
            </article>
          );
        })}
      </div>
    </section>
  )}
</section>
