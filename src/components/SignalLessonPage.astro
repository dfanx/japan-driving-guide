---
import { z } from "astro/zod";

import { diagramManifestSchema } from "../../tools/diagram-generator/src/manifest";
import { diagramSceneSchema } from "../../tools/diagram-generator/src/schema";
import sceneData from "../../tools/diagram-generator/scenes/D002.json";
import diagramManifestData from "../data/diagram-manifest.json";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getRuleById } from "../lib/content/catalog";
import { lessonFrontmatterSchema } from "../lib/content/lesson-schema";
import { getDriverSimulationByDiagramId, getVisualGuidance } from "../lib/content/lesson-visuals";
import { lessonNavigation } from "../lib/content/lesson-navigation";
import { withBase } from "../lib/paths";
import LearningShell from "./LearningShell.astro";
import LessonVisuals from "./LessonVisuals.astro";

const locale = z.enum(["zh-TW", "en"]).parse(Astro.props.locale);
const lessonMeta = lessonFrontmatterSchema.parse(Astro.props.lesson);
const rule = getRuleById("JP-RULE-SIGNAL-RED-001");
const scene = diagramSceneSchema.parse(sceneData);
const driverSimulation = getDriverSimulationByDiagramId(scene.id);
const guidance = getVisualGuidance(scene.id);
const manifest = diagramManifestSchema.parse(diagramManifestData);
const diagramEntry = manifest.items.find((item) => item.id === scene.id);
const lessonIndex = lessonNavigation.findIndex((item) => item.id === lessonMeta.id);
const previous = lessonNavigation[lessonIndex - 1];
const next = lessonNavigation[lessonIndex + 1];

if (lessonMeta.locale !== locale || lessonMeta.id !== "M02-signals") {
  throw new Error("Signal lesson route received mismatched lesson metadata");
}
if (
  lessonMeta.reviewStatus !== "approved" ||
  rule.reviewStatus !== "approved" ||
  scene.reviewStatus !== "approved" ||
  diagramEntry?.reviewStatus !== "approved"
) {
  throw new Error("Signal lesson dependencies must all be approved");
}
if (!lessonMeta.ruleIds.includes(rule.id) || !lessonMeta.diagramIds.includes(scene.id)) {
  throw new Error("M02, D002, and the red-signal Rule are not aligned");
}

const isEnglish = locale === "en";
const copy = isEnglish
  ? {
      description: "Learn the red-light decision every overseas visitor should know before driving in Japan.",
      skipLabel: "Skip to main content",
      railLabel: "Learn modules",
      railEyebrow: "Full guide",
      lessonNumber: "Lesson 02",
      practicalLabel: "Use this on the road",
      eyebrow: "Road decision",
      lead: "A clear road does not override a red signal.",
      sectionLabel: "See the situation",
      sectionTitle: "Red light, empty junction—what now?",
      watch: "Watch for",
      action: "Do this",
      decision: "How to read it",
      previous: "Previous lesson",
      next: "Next lesson",
      index: "All lessons",
      review: "Final 25-question review",
      footer: "Finish all 16 lessons, then use the final review to check your first reaction.",
    }
  : {
      description: "日本紅燈到底能不能轉？先看現場，再把正確反應記成直覺。",
      skipLabel: "跳到主要內容",
      railLabel: "16 課攻略",
      railEyebrow: "完整課程",
      lessonNumber: "第 02 課",
      practicalLabel: "上路會用到",
      eyebrow: "駕駛判斷",
      lead: "路口沒車，也不能把紅燈當成可以轉。",
      sectionLabel: "先看情境",
      sectionTitle: "紅燈、路口沒車，現在怎麼做？",
      watch: "先注意",
      action: "建議做法",
      decision: "看圖判斷",
      previous: "上一課",
      next: "下一課",
      index: "全部 16 課",
      review: "25 題上路前總複習",
      footer: "看完 16 課，再用總複習確認自己的第一反應。",
    };
const localeLinks = { "zh-TW": "/zh-TW/learn/signals/", en: "/en/learn/signals/" };
---

<BaseLayout title={`${lessonMeta.title} | Japan Driving Guide`} description={copy.description} locale={locale} skipLabel={copy.skipLabel}>
  <LearningShell currentLocale={locale} localeLinks={localeLinks} railLabel={copy.railLabel}>
    <nav slot="rail" aria-label={copy.railLabel}>
      <p class="rail-label">{copy.railEyebrow}</p>
      <ol class="rail-list module-rail-list">
        {lessonNavigation.map((item) => (
          <li aria-current={item.id === lessonMeta.id ? "step" : undefined}>
            <span class="rail-list__marker" data-state={item.id === lessonMeta.id ? "current" : undefined}>{String(item.order + 1).padStart(2, "0")}</span>
            <a href={withBase(`/${locale}/learn/${item.slug}/`)}>{item.title[locale]}</a>
          </li>
        ))}
      </ol>
    </nav>

    <article id={lessonMeta.id} class="lesson-page" data-lesson-id={lessonMeta.id} data-rule-id={rule.id} data-diagram-id={scene.id}>
      <header class="lesson-hero">
        <div class="lesson-meta"><span>{copy.lessonNumber}</span><span>{copy.practicalLabel}</span></div>
        <p class="eyebrow">{copy.eyebrow}</p>
        <h1>{lessonMeta.title}</h1>
        <p class="lead lesson-lead">{copy.lead}</p>
      </header>

      <section class="lesson-visuals signal-primary-scenario" data-scenario-pair data-paired-diagram-id="D002" aria-labelledby="signal-primary-title">
        <header class="section-heading lesson-visuals__heading">
          <p class="eyebrow">{copy.sectionLabel}</p>
          <h2 id="signal-primary-title">{copy.sectionTitle}</h2>
        </header>
        <div class="lesson-diagram-sequence">
          <figure class="lesson-diagram lesson-diagram--simulation" data-driver-simulation data-simulation-id={driverSimulation.id}>
            <img src={withBase(driverSimulation.assetPath)} alt={driverSimulation.alt[locale]} width={driverSimulation.width} height={driverSimulation.height} loading="eager" decoding="sync" />
            <figcaption class="visual-teaching-caption">
              <p class="visual-teaching-caption__lead"><span class="visual-badge">{copy.sectionLabel}</span>{guidance.situation[locale]}</p>
              <dl class="visual-teaching-points"><div><dt>{copy.watch}</dt><dd>{guidance.watch[locale]}</dd></div></dl>
            </figcaption>
          </figure>

          <figure class="lesson-diagram" aria-labelledby="D002-caption">
            <img src={withBase("/diagrams/D002.svg")} alt={scene.alt[locale]} width="1200" height="800" loading="eager" decoding="sync" data-testid="lesson-diagram" />
            <figcaption class="visual-teaching-caption" id="D002-caption">
              <p class="visual-teaching-caption__lead"><span class="visual-badge visual-badge--action">{copy.action}</span>{guidance.action[locale]}</p>
              <dl class="visual-teaching-points"><div><dt>{copy.decision}</dt><dd>{scene.alt[locale]}</dd></div></dl>
            </figcaption>
          </figure>
        </div>
      </section>

      <LessonVisuals lessonId={lessonMeta.id} locale={locale} excludeDiagramIds={["D002"]} />

      <section class="lesson-copy" data-testid="lesson-copy"><slot /></section>

      <nav class="lesson-pagination" aria-label={copy.railLabel}>
        {previous ? <a rel="prev" href={withBase(`/${locale}/learn/${previous.slug}/`)}>← {copy.previous}: {previous.title[locale]}</a> : <span />}
        <a href={withBase(`/${locale}/learn/`)}>{copy.index}</a>
        {next ? <a rel="next" href={withBase(`/${locale}/learn/${next.slug}/`)}>{copy.next}: {next.title[locale]} →</a> : <a href={withBase(`/${locale}/review/`)}>{copy.review} →</a>}
      </nav>
    </article>

    <div slot="footer"><p>{copy.footer} <a href={withBase(`/${locale}/review/`)}>{copy.review}</a></p></div>
  </LearningShell>
</BaseLayout>
