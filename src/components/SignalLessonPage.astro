---
import diagramManifestData from "../data/diagram-manifest.json";
import BaseLayout from "../layouts/BaseLayout.astro";
import { lessonFrontmatterSchema } from "../lib/content/lesson-schema";
import { getQuestionById, getRuleById } from "../lib/content/catalog";
import { getDriverSimulationByDiagramId } from "../lib/content/lesson-visuals";
import { lessonNavigation } from "../lib/content/lesson-navigation";
import { withBase } from "../lib/paths";
import LearningShell from "./LearningShell.astro";
import LessonVisuals from "./LessonVisuals.astro";
import { diagramManifestSchema } from "../../tools/diagram-generator/src/manifest";
import { diagramSceneSchema } from "../../tools/diagram-generator/src/schema";
import sceneData from "../../tools/diagram-generator/scenes/D002.json";
import { z } from "astro/zod";

const locale = z.enum(["zh-TW", "en"]).parse(Astro.props.locale);
const lesson = Astro.props.lesson;
const lessonMeta = lessonFrontmatterSchema.parse(lesson);
const question = getQuestionById("Q002");
const rule = getRuleById("JP-RULE-SIGNAL-RED-001");
const scene = diagramSceneSchema.parse(sceneData);
const driverSimulation = getDriverSimulationByDiagramId(scene.id);
const manifest = diagramManifestSchema.parse(diagramManifestData);
const diagramEntry = manifest.items.find((item) => item.id === scene.id);

if (lessonMeta.locale !== locale || lessonMeta.id !== "M02-signals") {
  throw new Error("Signal lesson route received mismatched lesson metadata");
}
if (
  lessonMeta.reviewStatus !== "approved" ||
  rule.reviewStatus !== "approved" ||
  question.reviewStatus !== "approved" ||
  scene.reviewStatus !== "approved" ||
  diagramEntry?.reviewStatus !== "approved"
) {
  throw new Error("Signal lesson dependencies must all be approved");
}
if (
  !lessonMeta.ruleIds.includes(rule.id) ||
  !lessonMeta.diagramIds.includes(scene.id) ||
  question.diagramId !== scene.id ||
  !question.ruleIds.includes(rule.id)
) {
  throw new Error("M02, D002, Q002, and the red-signal Rule are not aligned");
}

const isEnglish = locale === "en";
const copy = isEnglish
  ? {
      description:
        "Learn the red-light rule every overseas visitor should know before driving in Japan.",
      skipLabel: "Skip to main content",
      railLabel: "Lesson scope",
      railEyebrow: "Learn modules",
      lessonNumber: "Lesson 02",
      legalLabel: "Legal rule",
      lead: "A clear road does not override a red signal.",
      figureLabel: "Decision scene",
      simulationLabel: "Driver's view · generated simulation",
      simulationNote:
        "Context only. Use the exact diagram below to identify the signal and stopping position.",
      figureCaption:
        "Vehicle A stops before the stop line. The traffic-light face is the exact image published by Japan’s National Police Agency.",
      checkpointLabel: "Scenario check · Q002",
      checkpointTitle: "Make the call",
      checkpointNote:
        "Choose one answer. Your first answer is final for this checkpoint.",
      optionLabel: "Answer choices",
      submitLabel: "Check answer",
      correctLabel: "Correct",
      incorrectLabel: "Incorrect",
      explanationLabel: "Why",
      resultButtonLabel: "View review result",
      resultEyebrow: "This session",
      resultTitle: "Review recommendation",
      weaknessTagLabel: "Signals",
      strongResultLabel: "Correct this time",
      reviewResultLabel: "Review recommended",
      priorityReviewResultLabel: "Priority review",
      strongResultMessage:
        "You answered correctly. One question is not enough to confirm mastery, so keep this lesson available for review.",
      reviewResultMessage:
        "Review this lesson before driving. More answered questions are needed for a stable result.",
      priorityReviewResultMessage:
        "Review this signal rule before driving. The incorrect answer shows a high-priority gap, but the sample is still limited.",
      limitedSampleLabel: "Limited sample · based on 1 answered question",
      sufficientSampleLabel: "Based on multiple answered questions",
      reviewLinkLabel: "Review the Signals lesson",
      sourceNote: "Official rule verification date",
      recheckNote: "Recheck current official guidance before driving.",
    }
  : {
      description: "日本紅燈到底能不能轉？用一張圖和一題情境快速搞懂。",
      skipLabel: "跳至主要內容",
      railLabel: "16 課攻略",
      railEyebrow: "完整課程",
      lessonNumber: "第 02 課",
      legalLabel: "日本法規",
      lead: "路口沒車，也不能把紅燈當成可以轉。",
      figureLabel: "先看圖",
      simulationLabel: "駕駛座視角 · 生成模擬",
      simulationNote: "只用來看現場視野；號誌與停車位置請以下方精準解說圖為準。",
      figureCaption:
        "A 車停在停止線前；號誌圖取自日本警察廳官方資料。",
      checkpointLabel: "你會怎麼開？ · Q002",
      checkpointTitle: "選一個答案",
      checkpointNote: "送出後不能修改。",
      optionLabel: "答案選項",
      submitLabel: "確認答案",
      correctLabel: "答對了",
      incorrectLabel: "答案不正確",
      explanationLabel: "原因",
      resultButtonLabel: "看複習建議",
      resultEyebrow: "這次作答",
      resultTitle: "複習建議",
      weaknessTagLabel: "號誌",
      strongResultLabel: "本題答對",
      reviewResultLabel: "建議複習",
      priorityReviewResultLabel: "建議優先複習",
      strongResultMessage:
        "這題答對了。上路前再掃一次，別讓母國習慣接管方向盤。",
      reviewResultMessage: "上路前再看一次這課，先把紅燈反應練成直覺。",
      priorityReviewResultMessage:
        "先別急著上路。把這條紅燈規則重看一次，再做其他情境題。",
      limitedSampleLabel: "只看 1 題，還不能代表完全熟悉",
      sufficientSampleLabel: "依多題作答結果",
      reviewLinkLabel: "重看號誌課",
      sourceNote: "規則查核日",
      recheckNote: "出發前仍要以日本現場標誌、號誌和最新官方資訊為準。",
    };
const localeLinks = {
  "zh-TW": "/zh-TW/learn/signals/",
  en: "/en/learn/signals/",
};
const localizedQuestion = question.prompt[locale];
const localizedOptions = question.options.map((option) => ({
  id: option.id,
  text: option.text[locale],
}));
const localizedExplanation = question.explanation[locale];
const questionPayload = JSON.stringify(question);
const reviewHref = `${withBase(localeLinks[locale])}#${lessonMeta.id}`;
---

<BaseLayout
  title={`${lessonMeta.title} | Japan Driving Guide`}
  description={copy.description}
  locale={locale}
  skipLabel={copy.skipLabel}
>
  <LearningShell
    currentLocale={locale}
    localeLinks={localeLinks}
    railLabel={copy.railLabel}
  >
    <nav slot="rail" aria-label={copy.railLabel}>
      <p class="rail-label">{copy.railEyebrow}</p>
      <ol class="rail-list module-rail-list">
        {
          lessonNavigation.map((item) => (
            <li aria-current={item.id === lessonMeta.id ? "step" : undefined}>
              <span
                class="rail-list__marker"
                data-state={item.id === lessonMeta.id ? "current" : undefined}
              >
                {String(item.order + 1).padStart(2, "0")}
              </span>
              <a href={withBase(`/${locale}/learn/${item.slug}/`)}>{item.title[locale]}</a>
            </li>
          ))
        }
      </ol>
    </nav>

    <article
      id={lessonMeta.id}
      class="lesson-page"
      data-lesson-id={lessonMeta.id}
      data-rule-id={rule.id}
      data-diagram-id={scene.id}
      data-question-id={question.id}
    >
      <header class="lesson-hero">
        <div class="lesson-meta" aria-label={copy.legalLabel}>
          <span>{copy.lessonNumber}</span>
          <span>{copy.legalLabel}</span>
        </div>
        <p class="eyebrow">Signals · {scene.id}</p>
        <h1>{lessonMeta.title}</h1>
        <p class="lead lesson-lead">{copy.lead}</p>
      </header>

      <section class="lesson-diagram-sequence" data-scenario-pair data-paired-diagram-id="D002" aria-label={copy.figureLabel}>
        <figure class="lesson-diagram lesson-diagram--simulation" data-driver-simulation data-simulation-id={driverSimulation.id}>
          <p class="diagram-label">{copy.simulationLabel}</p>
          <img
            src={withBase(driverSimulation.assetPath)}
            alt={driverSimulation.alt[locale]}
            width={driverSimulation.width}
            height={driverSimulation.height}
            loading="eager"
            decoding="sync"
          />
          <figcaption>{driverSimulation.alt[locale]} <small>{copy.simulationNote}</small></figcaption>
        </figure>

        <figure class="lesson-diagram" aria-labelledby="D002-caption">
          <p class="diagram-label">{copy.figureLabel} · D002</p>
          <img
            src={withBase("/diagrams/D002.svg")}
            alt={scene.alt[locale]}
            width="1200"
            height="800"
            loading="eager"
            decoding="sync"
            data-testid="lesson-diagram"
          />
          <figcaption id="D002-caption">{copy.figureCaption}</figcaption>
        </figure>
      </section>

      <LessonVisuals lessonId={lessonMeta.id} locale={locale} excludeDiagramIds={["D002"]} />

      <section class="lesson-copy" data-testid="lesson-copy">
        <slot />
      </section>

      <section class="checkpoint-card" id={question.id} aria-labelledby="Q002-title">
        <p class="checkpoint-label">{copy.checkpointLabel}</p>
        <h2 id="Q002-title">{copy.checkpointTitle}</h2>
        <form
          class="checkpoint-form"
          data-quiz-session
          data-question={questionPayload}
          data-correct-label={copy.correctLabel}
          data-incorrect-label={copy.incorrectLabel}
          data-expected-weakness-tag="signals"
          data-strong-result-label={copy.strongResultLabel}
          data-review-result-label={copy.reviewResultLabel}
          data-priority-review-result-label={copy.priorityReviewResultLabel}
          data-strong-result-message={copy.strongResultMessage}
          data-review-result-message={copy.reviewResultMessage}
          data-priority-review-result-message={copy.priorityReviewResultMessage}
          data-limited-sample-label={copy.limitedSampleLabel}
          data-sufficient-sample-label={copy.sufficientSampleLabel}
        >
          <fieldset class="checkpoint-fieldset" aria-describedby="Q002-note">
            <legend class="checkpoint-prompt">{localizedQuestion}</legend>
            <p class="checkpoint-note" id="Q002-note">{copy.checkpointNote}</p>
            <ul class="checkpoint-options" aria-label={copy.optionLabel}>
              {
                localizedOptions.map((option) => (
                  <li>
                    <label class="checkpoint-option" data-option-id={option.id}>
                      <input
                        class="checkpoint-option__input"
                        type="radio"
                        name={question.id}
                        value={option.id}
                        required
                      />
                      <span class="checkpoint-option__marker" aria-hidden="true">
                        {option.id}
                      </span>
                      <span>{option.text}</span>
                    </label>
                  </li>
                ))
              }
            </ul>
          </fieldset>
          <button class="checkpoint-submit" type="submit" data-quiz-submit>
            {copy.submitLabel}
          </button>
          <div
            class="checkpoint-feedback"
            data-quiz-feedback
            role="status"
            tabindex="-1"
            hidden
          >
            <p class="checkpoint-feedback__status" data-feedback-status></p>
            <p class="checkpoint-feedback__explanation">
              <strong>{copy.explanationLabel}:</strong> {localizedExplanation}
            </p>
          </div>
          <button
            class="checkpoint-result-trigger"
            type="button"
            data-result-trigger
            aria-controls="Q002-weakness-result"
            hidden
          >
            {copy.resultButtonLabel}
          </button>
          <section
            class="weakness-result"
            id="Q002-weakness-result"
            data-weakness-result
            aria-labelledby="Q002-weakness-title"
            tabindex="-1"
            hidden
          >
            <p class="weakness-result__eyebrow">{copy.resultEyebrow}</p>
            <h3 id="Q002-weakness-title">{copy.resultTitle}</h3>
            <div class="weakness-result__summary">
              <span class="weakness-result__tag">{copy.weaknessTagLabel}</span>
              <strong data-weakness-band-label></strong>
            </div>
            <p class="weakness-result__message" data-weakness-message></p>
            <p class="weakness-result__sample" data-weakness-sample-label></p>
            <a class="weakness-result__link" href={reviewHref}>
              {copy.reviewLinkLabel}
            </a>
          </section>
        </form>
      </section>
    </article>

    <div slot="footer">
      <p>{copy.sourceNote}: <time datetime={rule.verifiedAt}>{rule.verifiedAt}</time></p>
      <p>{copy.recheckNote}</p>
    </div>
  </LearningShell>
</BaseLayout>

<script>
  import { initializeQuizSessions } from "../lib/quiz/controller";

  initializeQuizSessions();
</script>
