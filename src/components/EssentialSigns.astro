---
import { z } from "astro/zod";

import { essentialSigns, getOfficialAssetsForSign } from "../lib/content/essential-signs";
import { withBase } from "../lib/paths";

const locale = z.enum(["zh-TW", "en"]).parse(Astro.props.locale);
const isEnglish = locale === "en";
const copy = isEnglish
  ? {
      eyebrow: "Official visual reference",
      title: "Ten signs worth recognizing before pickup",
      intro: "The sign faces below are exact Japanese-authority assets. The guide adds explanation around them but does not redraw or recolor them.",
      meaning: "Official meaning",
      action: "Driving response",
      source: "Open official source",
      assetNote: "Asset provenance",
      provenance: "NPA signs are exact PDF image objects; the railway warning is the exact MLIT GIF. ETC remains link-only because NEXCO's site terms prohibit reposting its image on another website.",
    }
  : {
      eyebrow: "標誌速查",
      title: "取車前先認這 10 類",
      intro: "交通標誌全部放日本主管機關原圖，不重畫、不改色。先看圖，再記看到時要做什麼。",
      meaning: "代表什麼",
      action: "看到怎麼做",
      source: "看日本官方資料",
      assetNote: "這些圖從哪來",
      provenance: "標誌圖來自日本警察廳，平交道警告圖來自國土交通省。NEXCO 不允許把 ETC 圖片轉貼到其他網站，所以本站只放官方連結。",
    };
---

<section class="essential-signs" aria-labelledby="essential-signs-title" data-essential-signs>
  <header class="section-heading">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h2 id="essential-signs-title">{copy.title}</h2>
    <p>{copy.intro}</p>
  </header>

  <div class="sign-card-grid">
    {essentialSigns.map((sign) => {
      const assets = getOfficialAssetsForSign(sign);
      return (
        <article class="sign-card" id={sign.id.toLowerCase()} data-sign-id={sign.id} data-rule-id={sign.ruleId}>
          <div class="sign-card__visual" data-count={assets.length || "link-only"}>
            {assets.map((asset, index) => (
              <figure class="sign-card__asset">
                <img
                  src={withBase(asset.assetPath)}
                  width={asset.width}
                  height={asset.height}
                  loading="eager"
                  alt={sign.assetLabels?.[index]?.[locale] ?? `${sign.title[locale]}${assets.length > 1 ? ` ${index + 1}` : ""}`}
                  data-asset-id={asset.id}
                />
                {sign.assetLabels?.[index] && <figcaption>{sign.assetLabels[index][locale]}</figcaption>}
              </figure>
            ))}
            {assets.length === 0 && <p class="sign-card__link-only">{sign.rightsNote?.[locale]}</p>}
          </div>
          <div class="sign-card__body">
            <p class="sign-card__class">{sign.class[locale]}</p>
            <h3>{sign.title[locale]}</h3>
            <dl>
              <div><dt>{copy.meaning}</dt><dd>{sign.meaning[locale]}</dd></div>
              <div><dt>{copy.action}</dt><dd>{sign.action[locale]}</dd></div>
            </dl>
            <a class="sign-card__source" href={sign.officialLink}>{copy.source} ↗</a>
          </div>
        </article>
      );
    })}
  </div>

  <details class="asset-provenance">
    <summary>{copy.assetNote}</summary>
    <p>{copy.provenance}</p>
    <ul>
      <li><a href="https://www.npa.go.jp/english/bureau/traffic/traffic-light_english.pdf">National Police Agency — Traffic Lights and Road Signs</a></li>
      <li><a href="https://www.kkr.mlit.go.jp/osaka/works/kouan/mijika/">MLIT Kinki Regional Development Bureau — road signs</a></li>
      <li><a href="https://global.w-nexco.co.jp/en/trafficrule/gates.html">NEXCO West — Toll Gates Information</a></li>
    </ul>
  </details>
</section>
