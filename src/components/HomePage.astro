---
import { z } from "astro/zod";

import BaseLayout from "../layouts/BaseLayout.astro";
import LearningShell from "./LearningShell.astro";
import { withBase } from "../lib/paths";

const locale = z.enum(["zh-TW", "en"]).parse(Astro.props.locale);
const isEnglish = locale === "en";
const localeLinks = { "zh-TW": "/zh-TW/", en: "/en/" };
const copy = isEnglish
  ? {
      title: "Drive Japan with judgment, not luck",
      description:
        "A practical sixteen-lesson safety guide for first-time drivers in Japan.",
      skipLabel: "Skip to main content",
      railLabel: "Start options",
      railEyebrow: "Before you collect the key",
      railItems: ["Lesson 01", "Sixteen lessons", "Final review"],
      eyebrow: "First time driving in Japan?",
      lead:
        "No turn on red, a full stop at 止まれ, and no assuming an empty roadside is legal parking. Learn the mistakes visitors make most often before pickup.",
      primaryAction: "Start Lesson 01",
      secondaryAction: "See the 16-lesson index",
      reviewAction: "Take the final review",
      pathLabel: "Complete beginner guide",
      pathTitle: "From rental documents to collision response",
      pathText:
        "Follow the lessons in order or jump to parking, ETC, snow, fuel or emergencies. Each one shows what you may see, what can go wrong, and what to do next.",
      timeLabel: "Time needed",
      timeValue: "16 lessons · about 30–45 min",
      note:
        "Recognize the scene first, then practise the decision you need to make behind the wheel.",
      footer: "Read it before pickup. Keep it for the road.",
    }
  : {
      title: "日本自駕別靠運氣，從第 1 課開始看懂",
      description: "給第一次在日本開車的旅客：16 堂情境課，約 30–45 分鐘完成。",
      skipLabel: "跳至主要內容",
      railLabel: "開始方式",
      railEyebrow: "領取租車前",
      railItems: ["第 1 課", "完整 16 課", "上路前總複習"],
      eyebrow: "第一次在日本開車？",
      lead: "紅燈不能轉、止まれ要停死、路邊空位不等於能停。先把旅客最常踩雷的規則看懂，再上路。",
      primaryAction: "開始第 1 課",
      secondaryAction: "查看 16 課目錄",
      reviewAction: "做 25 題總複習",
      pathLabel: "新手完整攻略",
      pathTitle: "從租車證件一路看到事故處理",
      pathText:
        "照順序讀，或直接跳去停車、ETC、雪地、加油和事故處理。每課都先看現場、抓風險，再記住怎麼做。",
      timeLabel: "需要多久",
      timeValue: "完整 16 課 · 約 30–45 分鐘",
      note: "先認出現場，再練習坐在駕駛座上該怎麼判斷。",
      footer: "先看懂，再上路。",
    };
const firstLessonHref = withBase(`/${locale}/learn/eligibility/`);
const learnHref = withBase(`/${locale}/learn/`);
const reviewHref = withBase(`/${locale}/review/`);
---

<BaseLayout
  title={`Japan Driving Guide | ${copy.eyebrow}`}
  description={copy.description}
  locale={locale}
  skipLabel={copy.skipLabel}
>
  <LearningShell currentLocale={locale} localeLinks={localeLinks} railLabel={copy.railLabel}>
    <nav slot="rail" aria-label={copy.railLabel}>
      <p class="rail-label">{copy.railEyebrow}</p>
      <ol class="rail-list">
        {copy.railItems.map((item, index) => (
          <li aria-current={index === 0 ? "step" : undefined}>
            <span class="rail-list__marker" data-state={index === 0 ? "current" : undefined}>
              {String(index + 1).padStart(2, "0")}
            </span>
            <span>{item}</span>
          </li>
        ))}
      </ol>
    </nav>

    <div class="home-page" data-home-locale={locale}>
      <header class="home-hero">
        <p class="eyebrow">{copy.eyebrow}</p>
        <h1>{copy.title}</h1>
        <p class="lead">{copy.lead}</p>
        <div class="home-actions">
          <a class="primary-action" href={firstLessonHref}>{copy.primaryAction}</a>
          <a class="secondary-action" href={learnHref}>{copy.secondaryAction}</a>
          <a class="secondary-action" href={reviewHref}>{copy.reviewAction}</a>
        </div>
      </header>

      <section class="path-card" aria-labelledby="reviewed-path-title">
        <div>
          <p class="status-label">{copy.pathLabel}</p>
          <h2 id="reviewed-path-title">{copy.pathTitle}</h2>
          <p>{copy.pathText}</p>
        </div>
        <dl class="scope-stat">
          <dt>{copy.timeLabel}</dt>
          <dd>{copy.timeValue}</dd>
        </dl>
        <p class="scope-note">{copy.note}</p>
      </section>
    </div>

    <div slot="footer">
      <p>{copy.footer}</p>
    </div>
  </LearningShell>
</BaseLayout>
