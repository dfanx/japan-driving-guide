---
import "../styles/global.css";
import { withBase } from "../lib/paths";

const {
  title = "Japan Driving Guide",
  description = "給海外旅客的日本自駕安全學習指南。",
  locale = "zh-TW",
  skipLabel = "跳至主要內容",
} = Astro.props;
const manifestHref = withBase("/manifest.webmanifest");
const serviceWorkerUrl = withBase("/sw.js");
const serviceWorkerScope = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f9fa" />
    <link rel="manifest" href={manifestHref} />
    <link rel="icon" href={withBase("/assets/app-icon.svg")} type="image/svg+xml" />
    <title>{title}</title>
    <script is:inline define:vars={{ serviceWorkerUrl, serviceWorkerScope }}>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register(serviceWorkerUrl, { scope: serviceWorkerScope });
        });
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{skipLabel}</a>
    <slot />
  </body>
</html>
